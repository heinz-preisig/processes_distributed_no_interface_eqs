digraph reactions {
label=reactions;
rankdir=LR;
subgraph cluster_reactions___network {
label=network;
rankdir=LR;
}

subgraph cluster_reactions___differenceOperator {
label=differenceOperator;
rankdir=LR;
}

subgraph cluster_reactions___frame {
label=frame;
rankdir=LR;
V_1 [fillcolor=cyan, fontsize=12, label=t, penwidth=3, style=filled];
}

subgraph cluster_reactions___state {
label=state;
rankdir=LR;
V_2 [fillcolor=lightcyan1, fontsize=12, label=n, penwidth=3, style=filled];
V_3 [fillcolor=lightcyan1, fontsize=12, label=V, penwidth=3, style=filled];
}

subgraph cluster_reactions___constant {
label=constant;
rankdir=LR;
}

subgraph cluster_reactions___effort {
label=effort;
rankdir=LR;
}

subgraph cluster_reactions___secondaryState {
label=secondaryState;
rankdir=LR;
}

subgraph cluster_reactions___diffState {
label=diffState;
rankdir=LR;
}

subgraph cluster_reactions___conversion {
label=conversion;
rankdir=LR;
}

subgraph cluster_reactions___controlInput {
label=controlInput;
rankdir=LR;
}

subgraph cluster_reactions___observation {
label=observation;
rankdir=LR;
}

}
