digraph info_processing {
label=info_processing;
rankdir=LR;
subgraph cluster_info_processing___network {
label=network;
rankdir=LR;
}

subgraph cluster_info_processing___frame {
label=frame;
rankdir=LR;
V_1 [fillcolor=lightcyan3, fontsize=12, label=t, penwidth=3, style=filled];
}

subgraph cluster_info_processing___state {
label=state;
rankdir=LR;
}

subgraph cluster_info_processing___constant {
label=constant;
rankdir=LR;
V_6 [fillcolor=tomato, fontsize=12, label=value, penwidth=3, style=filled];
}

}
