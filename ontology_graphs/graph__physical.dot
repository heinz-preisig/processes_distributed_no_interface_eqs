V_7 [fillcolor=lightcyan, fontsize=12, label=ry, penwidth=3, style=filled];
V_8 [fillcolor=lightcyan, fontsize=12, label=rz, penwidth=3, style=filled];
}

E_4 -> V_6  [splines=ortho];
E_4 -> V_7  [splines=ortho];
E_4 -> V_8  [splines=ortho];
subgraph cluster_physical___state {
label=state;
rankdir=LR;
V_10 [fillcolor=green, fontsize=12, label=S, penwidth=3, style=filled];
V_11 [fillcolor=green, fontsize=12, label=n, penwidth=3, style=filled];
V_12 [fillcolor=green, fontsize=12, label=V, penwidth=3, style=filled];
V_9 [fillcolor=green, fontsize=12, label=U, penwidth=3, style=filled];
E_4 [fillcolor=pink, fontsize=12, shape=box, style=filled];
E_4 -> V_12  [splines=ortho];
}

E_6 -> V_15  [splines=ortho];
E_6 -> V_16  [splines=ortho];
subgraph cluster_physical___constant {
label=constant;
rankdir=LR;
V_1 [fillcolor=lightcyan3, fontsize=12, label=value, penwidth=3, style=filled];
V_15 [fillcolor=lightcyan3, fontsize=12, label=kb, penwidth=3, style=filled];
V_16 [fillcolor=lightcyan3, fontsize=12, label=Avo, penwidth=3, style=filled];
V_17 [fillcolor=lightcyan3, fontsize=12, label=R, penwidth=3, style=filled];
V_2 [fillcolor=lightcyan3, fontsize=12, label=zero, penwidth=3, style=filled];
V_3 [fillcolor=lightcyan3, fontsize=12, label=one, penwidth=3, style=filled];
V_4 [fillcolor=lightcyan3, fontsize=12, label=onehalf, penwidth=3, style=filled];
E_6 [fillcolor=pink, fontsize=12, shape=box, style=filled];
E_6 -> V_17  [splines=ortho];
}

subgraph cluster_physical___effort {
label=effort;
rankdir=LR;
}

E_9 -> V_6  [splines=ortho];
E_9 -> V_7  [splines=ortho];
