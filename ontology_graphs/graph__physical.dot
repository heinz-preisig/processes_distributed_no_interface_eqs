digraph physical {
label=physical;
rankdir=LR;
subgraph cluster_physical___network {
label=network;
rankdir=LR;
}

subgraph cluster_physical___differenceOperator {
label=differenceOperator;
rankdir=LR;
}

subgraph cluster_physical___frame {
label=frame;
rankdir=LR;
V_18 [fillcolor=lightcyan, fontsize=12, label=t0, penwidth=3, style=filled];
V_19 [fillcolor=lightcyan, fontsize=12, label=te, penwidth=3, style=filled];
V_5 [fillcolor=lightcyan, fontsize=12, label=t, penwidth=3, style=filled];
