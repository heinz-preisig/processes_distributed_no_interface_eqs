digraph physical {
label=physical;
rankdir=LR;
subgraph cluster_physical___network {
label=network;
rankdir=LR;
}

subgraph cluster_physical___differenceOperator {
label=differenceOperator;
rankdir=LR;
}

subgraph cluster_physical___frame {
label=frame;
rankdir=LR;
V_1 [fillcolor=lightcyan3, fontsize=12, label=t, penwidth=3, style=filled];
}

subgraph cluster_physical___state {
label=state;
rankdir=LR;
V_2 [fillcolor=seagreen4, fontsize=12, label=n, penwidth=3, style=filled];
V_3 [fillcolor=seagreen4, fontsize=12, label=V, penwidth=3, style=filled];
}

E_3 -> V_2  [splines=ortho];
E_3 -> V_6  [splines=ortho];
subgraph cluster_physical___constant {
label=constant;
rankdir=LR;
V_6 [fillcolor=tomato, fontsize=12, label=value, penwidth=3, style=filled];
V_7 [fillcolor=tomato, fontsize=12, label=nt, penwidth=3, style=filled];
E_3 [fillcolor=pink, fontsize=12, shape=box, style=filled];
E_3 -> V_7  [splines=ortho];
}

subgraph cluster_physical___effort {
label=effort;
rankdir=LR;
}

subgraph cluster_physical___secondaryState {
label=secondaryState;
rankdir=LR;
}

subgraph cluster_physical___diffState {
label=diffState;
rankdir=LR;
}

subgraph cluster_physical___conversion {
label=conversion;
rankdir=LR;
}

subgraph cluster_physical___controlInput {
label=controlInput;
rankdir=LR;
}

E_5 -> V_2  [splines=ortho];
subgraph cluster_physical___observation {
label=observation;
rankdir=LR;
V_9 [fillcolor=lightcyan2, fontsize=12, label=xx, penwidth=3, style=filled];
E_5 [fillcolor=pink, fontsize=12, shape=box, style=filled];
E_5 -> V_9  [splines=ortho];
}

}
