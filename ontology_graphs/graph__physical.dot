V_20 [fillcolor=seagreen, fontsize=12, label=Axy, penwidth=3, style=filled];
V_21 [fillcolor=seagreen, fontsize=12, label=Axz, penwidth=3, style=filled];
V_22 [fillcolor=seagreen, fontsize=12, label=Ayz, penwidth=3, style=filled];
