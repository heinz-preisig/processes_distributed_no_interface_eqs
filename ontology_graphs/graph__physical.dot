digraph physical {
label=physical;
rankdir=LR;
subgraph cluster_physical___network {
label=network;
rankdir=LR;
}

subgraph cluster_physical___differenceOperator {
label=differenceOperator;
rankdir=LR;
}

subgraph cluster_physical___frame {
label=frame;
rankdir=LR;
V_5 [fillcolor=white, fontsize=12, label=t, penwidth=3, style=filled];
V_6 [fillcolor=white, fontsize=12, label=r_x, penwidth=3, style=filled];
V_7 [fillcolor=white, fontsize=12, label=r_y, penwidth=3, style=filled];
V_8 [fillcolor=white, fontsize=12, label=r_z, penwidth=3, style=filled];
}

E_4 -> V_6  [splines=ortho];
E_4 -> V_7  [splines=ortho];
E_4 -> V_8  [splines=ortho];
subgraph cluster_physical___state {
label=state;
rankdir=LR;
V_10 [fillcolor=green, fontsize=12, label=S, penwidth=3, style=filled];
V_11 [fillcolor=green, fontsize=12, label=n, penwidth=3, style=filled];
V_9 [fillcolor=green, fontsize=12, label=U, penwidth=3, style=filled];
V_12 [fillcolor=green, fontsize=12, label=V, penwidth=3, style=filled];
E_4 [fillcolor=pink, fontsize=12, shape=box, style=filled];
E_4 -> V_12  [splines=ortho];
}

subgraph cluster_physical___constant {
label=constant;
rankdir=LR;
V_1 [fillcolor=lightcyan3, fontsize=12, label=value, penwidth=3, style=filled];
V_2 [fillcolor=lightcyan3, fontsize=12, label=zero, penwidth=3, style=filled];
V_3 [fillcolor=lightcyan3, fontsize=12, label=one, penwidth=3, style=filled];
V_4 [fillcolor=lightcyan3, fontsize=12, label=onehalf, penwidth=3, style=filled];
}

subgraph cluster_physical___effort {
label=effort;
rankdir=LR;
}

subgraph cluster_physical___secondaryState {
label=secondaryState;
rankdir=LR;
}

subgraph cluster_physical___diffState {
label=diffState;
rankdir=LR;
}

subgraph cluster_physical___conversion {
label=conversion;
rankdir=LR;
}

subgraph cluster_physical___controlInput {
label=controlInput;
rankdir=LR;
}

subgraph cluster_physical___observation {
label=observation;
rankdir=LR;
}

}
